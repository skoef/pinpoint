#: game/templates/game/play.html:20
#, python-format
msgid "Waypoint %(num)s of %(total)s"
msgstr "Waypoint %(num)s van %(total)s"

#: game/templates/game/play.html:26
msgid "Waiting for location…"
msgstr "Locatie bepalen…"

#: game/templates/game/play.html:38 game/templates/game/play.html:60
msgid "Finish"
msgstr "Klaar"

#: game/templates/game/play.html:38 game/templates/game/play.html:60
msgid "Next waypoint"
msgstr "Volgend waypoint"

#: game/templates/game/play.html:49
msgid "Your answer…"
msgstr "Jouw antwoord…"

#: game/templates/game/play.html:51
msgid "That's not correct, try again."
msgstr "Dat is niet correct, probeer opnieuw."

#: game/templates/game/play.html:53
msgid "Submit"
msgstr "Versturen"

#: game/templates/game/play.html:70
#, python-format
msgid "Get within %(meters)s m to continue"
msgstr "Kom binnen %(meters)s m om door te gaan"

#: game/templates/game/play.html:85
#, python-brace-format
msgid "Accuracy: ±{accuracy} m"
msgstr "Nauwkeurigheid: ±{accuracy} m"

#: game/templates/game/play.html:86
msgid ""
"Could not detect your location. Make sure location access is enabled in your "
"browser and device settings."
msgstr ""
"Kon je locatie niet bepalen. Zorg dat locatietoegang is ingeschakeld in je "
"browser- en apparaatinstellingen."

#: game/templates/game/play.html:87
msgid "Location access denied. Enable it in your browser settings and reload."
msgstr "Locatietoegang geweigerd. Schakel dit in via je browserinstellingen en herlaad de pagina."

#: game/templates/game/play.html:88
msgid "Geolocation is not supported by this browser."
msgstr "Geolocatie wordt niet ondersteund door deze browser."

#: game/templates/game/play.html:89
msgid "Close enough — advancing…"
msgstr "Dichtbij genoeg — verdergaan…"

#: game/templates/game/play.html:90
#, python-brace-format
msgid "Get within {meters} m to continue ({distance} m away)"
msgstr "Kom binnen {meters} m om door te gaan ({distance} m weg)"

#: game/templates/game/play.html:91
#, python-brace-format
msgid "Get within {meters} m to continue"
msgstr "Kom binnen {meters} m om door te gaan"

#: game/templates/game/play_empty.html:15
msgid "This route has no waypoints yet."
msgstr "Deze route heeft nog geen waypoints."

#: game/templates/game/play_finished.html:6
msgid "Finished!"
msgstr "Klaar!"

#: game/templates/game/play_finished.html:15
msgid "You finished!"
msgstr "Je hebt het gehaald!"

#: game/templates/game/play_intro.html:19
#: game/templates/game/route_list.html:17
#, python-format
msgid "%(count)s waypoint"
msgid_plural "%(count)s waypoints"
msgstr[0] "%(count)s waypoint"
msgstr[1] "%(count)s waypoints"

#: game/templates/game/play_intro.html:28
msgid "Allow your browser to access your location when prompted."
msgstr "Geef je browser toegang tot je locatie wanneer daarom wordt gevraagd."

#: game/templates/game/play_intro.html:32
msgid ""
"The app shows how many <strong>meters</strong> you are from the next hidden "
"location — navigate towards it."
msgstr ""
"De app laat zien hoeveel <strong>meter</strong> je nog van de volgende "
"verborgen locatie verwijderd bent — navigeer ernaar toe."

#: game/templates/game/play_intro.html:36
msgid "Once you arrive, follow the instructions to unlock the next waypoint."
msgstr "Zodra je aankomt, volg de instructies om het volgende waypoint te ontgrendelen."

#: game/templates/game/play_intro.html:40
#, python-format
msgid "Find the 1 waypoint to complete the route!"
msgid_plural "Find all %(count)s waypoints to complete the route!"
msgstr[0] "Vind het ene waypoint om de route te voltooien!"
msgstr[1] "Vind alle %(count)s waypoints om de route te voltooien!"

